# Copy this file to ".env" for local use. On Railway, add these in the
# service's "Variables" tab instead. NEVER commit a real ".env".

# REQUIRED - get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Admin panel login. ADMIN_PASSWORD_HASH must be a SHA-256 hex digest:
#   python -m scripts.generate_admin_password_hash
# If unset, admin login always fails (safe default).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-the-generated-sha256-hash-here

# ---- Optional (sensible defaults are built in) ----
# Gemini model. gemini-1.5-flash is RETIRED. Faster/cheaper alternative:
# gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash
# Per-attempt Gemini timeout in seconds
# LLM_TIMEOUT_SECONDS=12
# Max output tokens per answer (lower = faster)
# LLM_MAX_OUTPUT_TOKENS=400
# Store the SQLite databases on a Railway Volume (e.g. mount at /data)
# DATA_DIR=/data
# Turn off structured timing logs
# PERF_LOGGING=false