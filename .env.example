# Copy this file to ".env" and fill in your real key.
# NEVER commit the real ".env" file — it's already in .gitignore.

# Get a free Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Day 11: admin panel login. ADMIN_PASSWORD_HASH must be a SHA-256 hex
# digest, NOT your plaintext password — generate it with:
#   python -m scripts.generate_admin_password_hash
# If ADMIN_PASSWORD_HASH is left unset, admin login always fails (safe
# default — the panel is never accidentally left open).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-the-generated-sha256-hash-here
